# env-manager: procrastimate
# env-manager target: app-web format=ts path=.env.local generate=env.ts
# env-manager target: server format=ts path=.env.local generate=src/env.ts
# env-manager target: scripts format=ts path=.env.local generate=env.ts
# env-manager target: app-ios format=swift path=Config/LocalSecrets.xcconfig

# env-manager targets: app-web,app-ios
API_URL=http://127.0.0.1:6121 # {url}

# env-manager targets: app-web
CLIENT_PORT=6120 # {int:min(1),max(65535)}
CLIENT_HOST=procrastimate.localhost # {optional string}
# The database and PowerSync of the API server Playwright starts, separate from the dev server's. scripts/setup-worktree.ts writes both.
E2E_DATABASE_URL= # {optional url}
E2E_POWERSYNC_URL= # {optional url}

# env-manager targets: app-web,server,app-ios
# `production` in prod, `development` in dev. Tests force it empty, which turns reporting off.
SENTRY_ENVIRONMENT= # {optional string:format(/^(production|development)$/)}

# env-manager targets: app-web,server
# The deploy sets the commit SHA. Local development falls back to `git rev-parse HEAD`.
SENTRY_RELEASE= # {optional string}

# env-manager targets: server
# Optional here so `env-manager gen --local` builds without AWS. server/src/config.ts requires the production ones.
API_PORT=6121 # {int:min(1),max(65535)}
VAPID_PUBLIC_KEY= # {optional string}
VAPID_PRIVATE_KEY= # {optional string}
ELEVENLABS_API_KEY= # {optional string}
RAMBLE_UPSTREAM= # {optional string:format(/^cassette$/)}
# The Bun dev server, scripts, and tests. The Worker reaches Postgres through the HYPERDRIVE binding instead.
DATABASE_URL= # {optional url}
# Where the server forwards /api/powersync/*: the worktree's Docker container locally, PowerSync Cloud in dev and prod.
POWERSYNC_URL= # {optional url}
# The Ed25519 private JWK (with kid) that signs PowerSync tokens. Empty locally: the Bun server falls back to powersync/local/INSECURE-dev-jwt-key.json.
POWERSYNC_JWT_PRIVATE_KEY= # {optional string}
BETTER_AUTH_SECRET= # {optional string}
# `off` disables Better Auth's sign-in rate limit, for unit and end to end tests that sign up many users from one address.
AUTH_RATE_LIMIT= # {optional string:format(/^off$/)}
GOOGLE_CLIENT_ID= # {optional string}
GOOGLE_CLIENT_SECRET= # {optional string}
GOOGLE_IOS_CLIENT_ID= # {optional string}
APPLE_CLIENT_ID= # {optional string}
APPLE_CLIENT_SECRET= # {optional string}
APPLE_TEAM_ID= # {optional string}
APPLE_KEY_ID= # {optional string}
APPLE_PRIVATE_KEY= # {optional string}

# env-manager targets: scripts
# Deploy, TestFlight, Supabase, PowerSync Cloud, and agent credentials. Never Worker bindings.
CLOUDFLARE_ACCOUNT_ID= # {optional string}
CLOUDFLARE_API_TOKEN= # {optional string}
ASC_KEY_ID= # {optional string}
ASC_ISSUER_ID= # {optional string}
ASC_PRIVATE_KEY_B64= # {optional string}
SUPABASE_ACCESS_TOKEN= # {optional string}
POWERSYNC_ADMIN_TOKEN= # {optional string}
POWERSYNC_DATABASE_PASSWORD= # {optional string}
# The old Turso database, read once by the git-ignored scripts/import-turso.ts at the cutover. Delete both after it.
TURSO_DATABASE_URL= # {optional url}
TURSO_AUTH_TOKEN= # {optional string}
APP_BOT_API_URL= # {optional url}
APP_BOT_TOKEN= # {optional string}
# Uploads source maps and creates releases in Sentry org self-uo7. A GitHub secret for the deploy job.
SENTRY_AUTH_TOKEN= # {optional string}
