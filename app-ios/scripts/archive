#!/usr/bin/env bash
# Archives the Release app and uploads it to App Store Connect (TestFlight) with an App Store Connect API key.
# Usage: ./scripts/archive [--export-only]
# Needs ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_PATH (the AuthKey_<id>.p8 file, kept outside the repo), and
# SENTRY_AUTH_TOKEN to upload the archive's dSYMs to Sentry project procrastimate-ios before anything ships.
# BUILD_NUMBER overrides the build number, which defaults to the current UTC time as year.MMdd.HHmmss: always higher,
# and within CFBundleVersion's three period-separated integers with a first integer of at most four digits.
set -euo pipefail
cd "$(dirname "$0")/.."

destination=upload
case "${1:-}" in
    "") ;;
    --export-only) destination=export ;;
    *) echo "usage: $0 [--export-only]" >&2; exit 64 ;;
esac

: "${ASC_KEY_ID:?Set ASC_KEY_ID to the App Store Connect API key id}"
: "${ASC_ISSUER_ID:?Set ASC_ISSUER_ID to the App Store Connect issuer id}"
: "${ASC_KEY_PATH:?Set ASC_KEY_PATH to the AuthKey_<id>.p8 path}"
: "${SENTRY_AUTH_TOKEN:?Set SENTRY_AUTH_TOKEN so the dSYMs reach Sentry; crashes are unreadable without them}"
# A Release build with no DSN stops at launch (AppEnvironment.telemetry), so refuse to archive one.
dsn=$(sed -n 's/^ *static let sentryDSN = "\(.*\)"$/\1/p' Sources/App/Environment.swift)
test -n "$dsn" || { echo "AppEnvironment.sentryDSN in Sources/App/Environment.swift is empty; set the procrastimate-ios DSN" >&2; exit 1; }
test -f "$ASC_KEY_PATH" || { echo "No key at $ASC_KEY_PATH" >&2; exit 1; }
key_path=$(cd "$(dirname "$ASC_KEY_PATH")" && pwd)/$(basename "$ASC_KEY_PATH")
repo=$(git rev-parse --show-toplevel)
case "$key_path" in
    "$repo"/*) echo "Keep the API key outside the repository: $key_path" >&2; exit 1 ;;
esac

read -r year monthday time < <(date -u '+%Y %m%d %H%M%S')
build_number=${BUILD_NUMBER:-$year.$((10#$monthday)).$((10#$time))}
team=FNYFHG5SV7
out=build/archive
archive=$out/App.xcarchive
auth=(
    -allowProvisioningUpdates
    -authenticationKeyPath "$key_path"
    -authenticationKeyID "$ASC_KEY_ID"
    -authenticationKeyIssuerID "$ASC_ISSUER_ID"
)

export_archive() {
    local destination=$1 path=$2
    mkdir -p "$path"
    cat > "$path.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>$destination</string>
    <key>teamID</key>
    <string>$team</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
</dict>
</plist>
PLIST
    xcodebuild -exportArchive -archivePath "$archive" -exportOptionsPlist "$path.plist" \
        -exportPath "$path" "${auth[@]}"
}

# Each bundle's entitlements file is Config/<bundle name>.entitlements, as CODE_SIGN_ENTITLEMENTS sets in the project,
# with the team prefix Xcode would substitute. A bundle without one stops the script.
bundles() {
    local app=$1
    echo "$app"
    find "$app/PlugIns" -maxdepth 1 -name '*.appex' 2>/dev/null
}
expected_entitlements() {
    local file
    file=Config/$(basename "${1%.*}").entitlements
    test -f "$file" || { echo "No $file for $(basename "$1")" >&2; return 1; }
    sed "s/\$(AppIdentifierPrefix)/$team./g" "$file"
}

rm -rf "$out"
mkdir -p "$out"

./scripts/generate

echo "Archiving version $(bun ../scripts/app-version.mts) build $build_number"
# Unsigned archive. Automatic signing here asks for an iOS App Development certificate, and a
# fresh runner creates another "Created via API" one. Export signs with Apple Distribution.
# SourcePackages is the clone directory testflight.yml caches.
xcodebuild archive -project App.xcodeproj -scheme App -configuration Release \
    -destination 'generic/platform=iOS' -archivePath "$archive" -clonedSourcePackagesDirPath SourcePackages \
    CURRENT_PROJECT_VERSION="$build_number" \
    CODE_SIGNING_ALLOWED=NO \
    CODE_SIGNING_REQUIRED=NO \
    CODE_SIGN_IDENTITY=""

# Export keeps only the entitlements the archived binaries are signed with, and an unsigned archive has none: TestFlight
# builds shipped without the app group, keychain groups, and associated domains (PROCRASTIMATE-IOS-C). An ad hoc
# signature carries them to export, which also adds their capabilities to the App Store profiles. Extensions first,
# since signing the app seals its PlugIns.
echo "Signing the archive ad hoc with each bundle's entitlements"
app=$(echo "$archive"/Products/Applications/*.app)
while read -r bundle; do
    expected_entitlements "$bundle" > "$out/sign.entitlements"
    codesign --force --sign - --entitlements "$out/sign.entitlements" "$bundle"
done < <(bundles "$app" | tail -r)

echo "Uploading dSYMs to Sentry"
bunx @sentry/cli@3.8.0 debug-files upload --org self-uo7 --project procrastimate-ios "$archive/dSYMs"

# Upload mode leaves no .ipa to inspect, so every run exports one and checks its signed entitlements first. The upload
# re-exports the same archive with the same profiles.
export_archive export "$out/export"
rm -rf "$out/ipa"
ditto -x -k "$out/export/App.ipa" "$out/ipa"
ipa_app=$(echo "$out"/ipa/Payload/*.app)
while read -r bundle; do
    expected_entitlements "$bundle" | plutil -convert json -o "$out/expected.json" -
    codesign -d --entitlements - --xml "$bundle" 2>/dev/null | plutil -convert json -o "$out/signed.json" -
    missing=$(jq -r --slurpfile signed "$out/signed.json" \
        'to_entries[] | select(.value != $signed[0][.key]) | .key' "$out/expected.json")
    if [ -n "$missing" ]; then
        echo "The exported $(basename "$bundle") lacks entitlements from its Config file:" >&2
        echo "$missing" >&2
        exit 1
    fi
done < <(bundles "$ipa_app")
echo "Every bundle in the .ipa carries its entitlements"

if [ "$destination" = upload ]; then
    export_archive upload "$out/upload"
    echo "Uploaded build $build_number. It shows in TestFlight once App Store Connect finishes processing."
else
    echo "Exported $out/export/App.ipa (build $build_number)"
fi
