#!/bin/sh
# Writes the app's generated sources (Core's API.swift, the App's Tokens.swift and AccentColor asset) and the repository's
# other generated files with `bun run generate`. Core's Generate phase calls it, so an Xcode build never compiles stale ones.
set -eu
# Xcode runs build phases without the login shell's PATH.
export PATH="$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v bun >/dev/null || { echo "error: bun is required to generate API.swift. Install it from https://bun.sh." >&2; exit 1; }
cd "$(dirname "$0")/../.."
test -d node_modules || { echo "error: Run \`bun install\` at the repository root first." >&2; exit 1; }
exec bun scripts/generate/index.ts
