#include? "LocalSecrets.xcconfig"
#include? "Env.xcconfig"

// After the include so archives ship the production API whatever the dev value is. `$()` keeps `//` from starting a comment.
API_URL[config=Release] = https:/$()/procrastinate.stf.lol
// Used when Env.xcconfig has not set one. A real iOS client id replaces this with the reversed Google scheme.
GOOGLE_URL_SCHEME = com.stefan.procrastinate
