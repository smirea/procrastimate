<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>API_URL</key>
    <string>$(API_URL)</string>
    <key>SENTRY_ENVIRONMENT</key>
    <string>$(SENTRY_ENVIRONMENT)</string>
    <key>GOOGLE_URL_SCHEME</key>
    <string>$(GOOGLE_URL_SCHEME)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>$(GOOGLE_URL_SCHEME)</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.stefan.procrastimate</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>procrastimate</string>
            </array>
        </dict>
    </array>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>notouroboros</string>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSCameraUsageDescription</key>
    <string>ProcrastiMate uses the camera to attach photos to tasks.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>ProcrastiMate uses the microphone to turn speech into tasks.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>ProcrastiMate uses speech recognition to turn what you say into tasks.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>ProcrastiMate uses your location to remind you of tasks when you arrive at or leave a place.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>ProcrastiMate watches the places on your tasks in the background, so it can remind you when you arrive or leave even while the app is closed.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>ProcrastiMate links tasks to calendar events and keeps their reminders in step when an event moves.</string>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.stefan.procrastimate.refresh</string>
        <string>com.stefan.procrastimate.places</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Todoist backup</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.zip-archive</string>
            </array>
        </dict>
    </array>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
</dict>
</plist>
