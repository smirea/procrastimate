				"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
			},
			"TimeOfDay": {
				"description": "Local wall-clock time, `HH:mm`.",
				"type": "string",
				"pattern": "^\\d{2}:\\d{2}$"
