{
	"module": "task",
	"timeZone": "America/New_York",
	"cases": [
		{
			"fn": "notificationTimes",
			"test": "notificationTimes › a due time notifies at that time with no reminder",
			"input": [
				{
					"date": "2026-10-15",
					"time": "17:00"
				},
				[]
			],
			"output": [
				1792098000000
			]
		},
		{
			"fn": "notificationTimes",
			"test": "notificationTimes › a date with no time does not notify",
			"input": [
				{
					"date": "2026-10-15",
					"time": null
				},
				[]
			],
			"output": []
		},
		{
			"fn": "notificationTimes",
			"test": "notificationTimes › a date with no time does not notify",
			"input": [
				null,
				[]
			],
			"output": []
		},
		{
			"fn": "notificationTimes",
			"test": "notificationTimes › reminders add to the due time, in order",
			"input": [
				{
					"date": "2026-10-15",
					"time": "17:00"
				},
				[
					{
						"date": "2026-10-15",
						"kind": "at",
						"time": "18:00"
					},
					{
						"kind": "before",
						"minutes": 30
					}
				]
			],
			"output": [
				1792096200000,
				1792098000000,
				1792101600000
			]
		},
		{
			"fn": "notificationTimes",
			"test": "notificationTimes › a reminder at the due time notifies once",
			"input": [
				{
					"date": "2026-10-15",
					"time": "17:00"
				},
				[
					{
						"kind": "before",
						"minutes": 0
					},
					{
						"date": "2026-10-15",
						"kind": "at",
						"time": "17:00"
					}
				]
			],
			"output": [
				1792098000000
			]
		},
		{
			"fn": "notificationTimes",
			"test": "notificationTimes › a date-only task still notifies at an absolute reminder",
			"input": [
				{
					"date": "2026-10-15",
					"time": null
				},
				[
					{
						"kind": "before",
						"minutes": 10
					},
					{
						"date": "2026-10-15",
						"kind": "at",
						"time": "09:00"
					}
				]
			],
			"output": [
				1792069200000
			]
		},
		{
			"fn": "dueAtTime",
			"test": "dueAtTime › keeps a date still ahead",
			"input": [
				{
					"date": "2026-10-20",
					"time": null
				},
				"08:00",
				"2026-10-14",
				"10:00"
			],
			"output": {
				"date": "2026-10-20",
				"time": "08:00"
			}
		},
		{
			"fn": "dueAtTime",
			"test": "dueAtTime › replaces the time it has",
			"input": [
				{
					"date": "2026-10-14",
					"time": "09:00"
				},
				"17:30",
				"2026-10-14",
				"10:00"
			],
			"output": {
				"date": "2026-10-14",
				"time": "17:30"
			}
		},
