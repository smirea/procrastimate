{
	"module": "list-header",
	"timeZone": "America/New_York",
	"cases": [
		{
			"fn": "listHeader",
			"test": "listHeader › every menu leads with share, copy, and show completed, in that order",
			"input": [
				{
					"kind": "project",
					"own": true
				}
			],
			"output": {
				"common": [
					"share",
					"copy",
					"show-completed"
				],
				"filters": true,
				"specific": [
					"add-section",
					"rename",
					"icon",
					"delete"
				]
			}
		},
		{
			"fn": "listHeader",
			"test": "listHeader › every menu leads with share, copy, and show completed, in that order",
			"input": [
				{
					"kind": "label",
					"own": true,
					"place": false
				}
			],
			"output": {
				"common": [
					"share",
					"copy",
					"show-completed"
				],
				"filters": true,
				"specific": [
					"rename",
					"color",
					"delete"
				]
			}
		},
		{
			"fn": "listHeader",
			"test": "listHeader › a shared project or label only copies and shows completed",
			"input": [
				{
					"kind": "project",
					"own": false
				}
			],
			"output": {
				"common": [
					"copy",
					"show-completed"
				],
				"filters": true,
				"specific": []
			}
		},
