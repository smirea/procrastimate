{
	"module": "links",
	"timeZone": "America/New_York",
	"cases": [
		{
			"fn": "linkify",
			"test": "linkify › \"Buy milk\" reads as \"Buy milk\"",
			"input": [
				"Buy milk"
			],
			"output": [
				{
					"end": 8,
					"href": null,
					"marks": [],
					"start": 0,
					"text": "Buy milk"
				}
			]
		},
		{
			"fn": "linkify",
			"test": "linkify › \"\" reads as \"\"",
			"input": [
				""
			],
			"output": []
		},
		{
			"fn": "linkify",
			"test": "linkify › \"Read https://example.com/a?b=1#top\" reads as \"Read |[https://example.com/a?b=1#top](https://example.com/a?b=1#top)\"",
			"input": [
				"Read https://example.com/a?b=1#top"
			],
			"output": [
				{
					"end": 5,
					"href": null,
					"marks": [],
					"start": 0,
					"text": "Read "
				},
				{
					"end": 34,
					"href": "https://example.com/a?b=1#top",
					"marks": [],
					"start": 5,
					"text": "https://example.com/a?b=1#top"
				}
			]
		},
		{
			"fn": "linkify",
			"test": "linkify › \"http://x.dev\" reads as \"[http://x.dev](http://x.dev)\"",
			"input": [
				"http://x.dev"
			],
			"output": [
				{
					"end": 12,
					"href": "http://x.dev",
					"marks": [],
					"start": 0,
					"text": "http://x.dev"
				}
			]
		},
		{
			"fn": "linkify",
			"test": "linkify › \"Visit www.site.com/path today\" reads as \"Visit |[www.site.com/path](https://www.site.com/path)| today\"",
			"input": [
				"Visit www.site.com/path today"
