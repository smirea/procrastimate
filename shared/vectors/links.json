					"marks": [],
					"start": 0,
					"text": "See "
				},
				{
					"end": 17,
					"href": "https://a.com",
					"marks": [],
					"start": 4,
					"text": "https://a.com"
				},
				{
					"end": 18,
					"href": null,
					"marks": [],
