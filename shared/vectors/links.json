{
	"module": "links",
	"timeZone": "America/New_York",
	"cases": [
		{
			"fn": "linkify",
			"test": "linkify › \"Buy milk\" reads as \"Buy milk\"",
			"input": [
				"Buy milk"
			],
			"output": [
				{
					"end": 8,
					"href": null,
					"marks": [],
					"start": 0,
					"text": "Buy milk"
				}
			]
		},
		{
			"fn": "linkify",
			"test": "linkify › \"\" reads as \"\"",
			"input": [
				""
			],
			"output": []
		},
		{
			"fn": "linkify",
			"test": "linkify › \"Read https://example.com/a?b=1#top\" reads as \"Read |[https://example.com/a?b=1#top](https://example.com/a?b=1#top)\"",
			"input": [
