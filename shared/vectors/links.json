				{
					"end": 20,
					"href": null,
					"marks": [],
					"start": 18,
					"text": " e"
				}
			]
		},
		{
			"fn": "linkify",
			"test": "linkify › highlight ranges become marks within each segment, on a Markdown link’s label",
			"input": [
				"meet [meetup.com](https://meetup.com) up",
				[
					[
						0,
						4
					],
					[
						6,
						10
					],
					[
						37,
						40
					]
				]
			],
			"output": [
				{
					"end": 5,
					"href": null,
					"marks": [
						[
							0,
							4
						]
					],
					"start": 0,
					"text": "meet "
				},
				{
					"end": 37,
					"href": "https://meetup.com",
					"marks": [
						[
							0,
							4
						]
					],
					"start": 5,
					"text": "meetup.com"
				},
				{
					"end": 40,
					"href": null,
					"marks": [
						[
							0,
							3
						]
					],
					"start": 37,
					"text": " up"
				}
			]
		},
