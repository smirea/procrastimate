		{
			"fn": "linkify",
			"test": "linkify › \"HTTPS://LOUD.COM\" reads as \"[HTTPS://LOUD.COM](HTTPS://LOUD.COM)\"",
			"input": [
				"HTTPS://LOUD.COM"
			],
			"output": [
				{
					"end": 16,
					"href": "HTTPS://LOUD.COM",
					"marks": [],
					"start": 0,
					"text": "HTTPS://LOUD.COM"
				}
			]
		},
		{
			"fn": "linkify",
			"test": "linkify › bare domains stay text",
			"input": [
