				{
					"end": 29,
					"href": null,
					"marks": [],
					"start": 23,
					"text": " today"
				}
			]
		},
		{
			"fn": "linkify",
			"test": "linkify › \"See https://a.com.\" reads as \"See |[https://a.com](https://a.com)|.\"",
