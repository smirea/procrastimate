			"fn": "creationHome",
			"test": "creationHome › a subtask goes where its parent is, whatever its project or labels say",
			"input": [
				{
					"ann-label": "ann",
					"ann-project": "ann",
					"ann-task": "ann",
					"bo-label": "bo"
				},
				{
					"labelIds": [
						"bo-label"
					],
					"projectId": null
				},
				"ann-task"
			],
			"output": "ann"
		},
		{
			"fn": "creationHome",
			"test": "creationHome › a subtask goes where its parent is, whatever its project or labels say",
