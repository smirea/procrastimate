{
	"module": "quick-add-buttons",
	"timeZone": "America/New_York",
	"cases": [
		{
			"fn": "toggleButton",
			"test": "toggleButton › pinning a button puts it last",
			"input": [
				[
					"subtasks",
					"date"
				],
				"labels"
			],
			"output": [
				"subtasks",
				"date",
				"labels"
			]
		},
		{
			"fn": "toggleButton",
			"test": "toggleButton › unpinning removes it",
			"input": [
				[
					"date",
					"priority",
					"reminders",
					"subtasks"
				],
				"reminders"
			],
			"output": [
				"date",
				"priority",
				"subtasks"
			]
		},
		{
			"fn": "toggleButton",
			"test": "toggleButton › a stored list with repeats comes back clean, in its order",
			"input": [
				[
					"subtasks",
					"date",
					"subtasks"
				],
				"event"
			],
			"output": [
				"subtasks",
				"date",
				"event"
			]
		},
		{
			"fn": "toggleButton",
			"test": "toggleButton › the last button can be unpinned, leaving only the + menu",
			"input": [
				[
					"date"
				],
				"date"
			],
			"output": []
		},
		{
			"fn": "moveButton",
			"test": "moveButton › moves a button before another",
			"input": [
				[
					"date",
					"priority",
					"reminders",
					"subtasks"
				],
				"subtasks",
				"priority"
			],
			"output": [
				"date",
				"subtasks",
				"priority",
				"reminders"
			]
		},
		{
			"fn": "moveButton",
			"test": "moveButton › moves a button down",
			"input": [
				[
					"date",
					"priority",
					"reminders"
				],
				"date",
				"reminders"
			],
			"output": [
				"priority",
				"date",
				"reminders"
			]
		},
		{
			"fn": "moveButton",
			"test": "moveButton › no neighbor moves it to the end",
			"input": [
				[
					"date",
					"priority",
					"reminders"
				],
				"date",
				null
			],
			"output": [
				"priority",
				"reminders",
				"date"
			]
		},
		{
			"fn": "moveButton",
			"test": "moveButton › the web reorders around iOS-only buttons without moving them",
			"input": [
				[
					"location",
					"date",
					"event",
					"labels"
				],
				"labels",
				"date"
			],
			"output": [
				"location",
				"labels",
				"date",
				"event"
			]
		},
		{
			"fn": "rowButtons",
			"test": "rowButtons › the default row",
			"input": [
				[
					"date",
					"priority",
					"reminders",
					"subtasks"
				],
				[],
				[
					"date",
					"priority",
					"reminders",
					"repeat",
					"labels",
					"subtasks",
					"location",
					"event"
				]
			],
			"output": [
				"date",
				"priority",
				"reminders",
				"subtasks"
			]
		},
		{
			"fn": "rowButtons",
			"test": "rowButtons › pinned buttons keep their stored order",
			"input": [
				[
					"subtasks",
					"date",
					"priority"
				],
				[],
				[
					"date",
					"priority",
					"reminders",
					"repeat",
					"labels",
					"subtasks",
					"location",
					"event"
				]
			],
			"output": [
				"subtasks",
				"date",
				"priority"
			]
		},
		{
			"fn": "rowButtons",
			"test": "rowButtons › a hidden button with a value still shows, after the pinned ones",
			"input": [
				[
					"subtasks",
					"date"
				],
				[
					"labels",
					"priority",
					"date"
				],
				[
					"date",
					"priority",
					"reminders",
					"repeat",
					"labels",
					"subtasks"
				]
			],
			"output": [
				"subtasks",
				"date",
				"priority",
				"labels"
			]
		},
		{
			"fn": "rowButtons",
			"test": "rowButtons › every supported button, pinned first, for settings and the + menu",
			"input": [
				[
					"labels",
					"date"
				],
				[
					"date",
					"priority",
					"reminders",
					"repeat",
					"labels",
					"subtasks"
				],
				[
					"date",
					"priority",
					"reminders",
					"repeat",
					"labels",
					"subtasks"
				]
			],
			"output": [
				"labels",
				"date",
				"priority",
				"reminders",
				"repeat",
				"subtasks"
			]
		},
		{
			"fn": "rowButtons",
			"test": "rowButtons › the web leaves out location and event, even when pinned",
			"input": [
				[
					"date",
					"location",
					"event"
				],
				[
					"event"
				],
				[
					"date",
					"priority",
					"reminders",
					"repeat",
					"labels",
					"subtasks"
				]
			],
			"output": [
				"date"
			]
		},
		{
			"fn": "rowButtons",
			"test": "rowButtons › nothing pinned and nothing set shows no buttons",
			"input": [
				[],
				[],
				[
					"date",
					"priority",
					"reminders",
					"repeat",
					"labels",
					"subtasks",
					"location",
					"event"
				]
			],
			"output": []
		}
	]
}
