{
	"name": "app-web",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"start": "bun ../scripts/generate/index.ts && bun --env-file=.env.local --bun run vite",
		"dev": "bun run start",
		"build": "bun ../scripts/generate/index.ts && bun --env-file=.env.local --bun run vite build",
		"check": "bun ../scripts/generate/index.ts && bun --env-file=.env.local --bun run svelte-kit sync && bun --env-file=.env.local run svelte-check-native --tsconfig ./tsconfig.json && bun check --no-script -p src/service-worker",
		"test:e2e": "bun ../scripts/generate/index.ts && bun --env-file=.env.local scripts/e2e-build.ts && bun --env-file=.env.local run playwright test"
	},
	"devDependencies": {
		"@fontsource-variable/google-sans-flex": "^5.3.1",
		"@orpc/client": "2.0.0-beta.43",
		"@orpc/contract": "2.0.0-beta.43",
		"@orpc/openapi": "2.0.0-beta.43",
		"@playwright/test": "^1.64.0",
		"@sentry/sveltekit": "11.8.0",
		"@sqlite.org/sqlite-wasm": "^3.54.1-build1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"drizzle-orm": "0.45.4",
		"fflate": "^0.8.3",
		"phosphor-svelte": "^3.1.1",
		"svelte": "^5.57.2",
		"svelte-check-native": "^1.10.0",
		"typescript": "^6"
	}
}
