	"sync": {
		"~orpc": {
			"errorMap": {},
			"meta": {
				"~openapi": {
					"method": "POST",
					"path": "/api/sync",
					"inputStructure": "detailed",
					"summary": "Sync the space",
					"description": "The apps’ replication protocol. `{ \"cursor\": 0, \"ops\": [] }` answers with the whole visible snapshot. A task op is applied when the task is editable before and after it, and a comment op when its task is editable and the comment is new or the caller’s own; project and label ops are acknowledged and dropped."
				}
			}
		}
	},
