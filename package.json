{
	"name": "procrastimate",
	"private": true,
	"workspaces": [
		"server",
		"app-web",
		"app-tinycast"
	],
	"scripts": {
		"lint": "oxlint --fix && oxfmt",
		"lint:ci": "oxlint && oxfmt --check",
		"test": "bun test",
		"generate": "bun scripts/generate/index.ts",
		"worktree:setup": "bun run generate && bun scripts/worktree-sim.ts install",
		"generate:watch": "bun --watch --no-clear-screen scripts/generate/index.ts",
		"vectors": "VECTORS=record TZ=America/New_York bun test shared",
		"vectors:check": "bun --no-env-file scripts/vectors-check.ts",
		"test:swift": "bun run generate && cd app-ios && swift test",
		"check": "bun run generate && bun check --no-script && bun run --cwd app-web check && bun run --cwd app-tinycast check",
		"start": "bun run generate && concurrently --raw -k -s first \"bun run start:server\" \"bun run start:client\" \"bun run generate:watch\"",
		"start:client": "bun run --cwd app-web start",
		"start:server": "bun run --cwd server start",
		"start:ios": "bun app-ios/scripts/run",
		"build": "bun run --cwd app-web build",
		"build:worker": "bun run build && wrangler deploy --dry-run",
		"preview": "bun run build && bun scripts/secrets.ts dev-vars && bun scripts/wrangler-dev.ts",
		"env:pull": "env-manager down",
		"env:ios": "bun scripts/secrets.ts ios",
		"secrets:push": "bun scripts/secrets.ts push",
		"secrets:github": "bun scripts/secrets.ts github",
		"secrets:check": "bun scripts/secrets.ts check"
	},
	"dependencies": {
		"@orpc/client": "2.0.0-beta.43",
		"@orpc/contract": "2.0.0-beta.43",
		"@orpc/openapi": "2.0.0-beta.43",
		"@orpc/server": "2.0.0-beta.43",
		"@orpc/zod": "2.0.0-beta.43",
		"@sentry/cloudflare": "11.8.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.4",
		"better-auth": "^1.7.7",
		"concurrently": "^10.0.6",
		"drizzle-orm": "0.45.4",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"sync-engine": "github:smirea/sync-engine#0388496",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261010.1",
		"@sentry/cli": "3.8.0",
		"wrangler": "^4.149.0"
	}
}
