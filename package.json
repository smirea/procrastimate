{
	"name": "procrastimate",
	"private": true,
	"workspaces": [
		"server",
		"app-web"
	],
	"scripts": {
		"lint": "oxlint --fix && oxfmt",
		"test": "bun test",
		"generate": "bun scripts/generate/index.ts",
		"generate:check": "bun scripts/generate/index.ts --check",
		"db:generate": "drizzle-kit generate && bun run generate",
		"vectors": "VECTORS=record TZ=America/New_York bun test shared",
		"test:e2e": "bun run --cwd app-web test:e2e",
		"check": "bunx --bun tsc --noEmit && bun run --cwd app-web check",
		"start": "concurrently --raw -k -s first \"bun run start:server\" \"bun run start:client\"",
		"start:client": "bun run --cwd app-web start",
		"start:server": "bun run --cwd server start",
		"start:ios": "bun app-ios/scripts/run",
		"build": "bun run --cwd app-web build",
		"preview": "bun run build && bun server/scripts/secrets.ts dev-vars && wrangler dev",
		"dev": "bun run start",
		"client:dev": "bun run start:client",
		"server:dev": "bun run start:server",
		"env:generate": "env-manager gen --local",
		"env:pull": "env-manager down",
		"env:ios": "bun server/scripts/secrets.ts ios",
		"secrets:push": "bun server/scripts/secrets.ts push",
		"secrets:github": "bun server/scripts/secrets.ts github",
		"secrets:check": "bun server/scripts/secrets.ts check"
	},
	"dependencies": {
		"@better-auth/memory-adapter": "1.7.7",
		"@libsql/client": "^0.18.0",
		"@libsql/kysely-libsql": "^0.4.1",
		"@orpc/client": "1.15.6",
		"@orpc/contract": "1.15.6",
		"@orpc/openapi": "1.15.6",
		"@orpc/openapi-client": "1.15.6",
		"@orpc/server": "1.15.6",
		"@orpc/zod": "1.15.6",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"better-auth": "^1.7.7",
		"concurrently": "^10.0.6",
		"drizzle-orm": "0.45.4",
		"es-toolkit": "^1.52.0",
		"kill-port-process": "^5.0.0",
		"kysely": "^0.29.6",
		"lefthook": "^2.2.1",
		"lodash": "^4.18.1",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261010.1",
		"drizzle-kit": "0.31.11",
		"wrangler": "^4.149.0"
	}
}
