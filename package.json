{
    "name": "procrastimate",
    "private": true,
    "scripts": {
        "lint": "oxlint --fix && oxfmt",
        "test": "bun test",
        "start": "concurrently --raw -k -s first \"bun run start:server\" \"bun run start:client\"",
        "start:client": "bun run --cwd app-web start",
        "start:server": "bun run --cwd server start",
        "start:ios": "bun app-ios/scripts/run",
        "dev": "bun run start",
        "client:dev": "bun run start:client",
        "server:dev": "bun run start:server",
        "env:generate": "env-manager gen --local"
    },
    "workspaces": [
        "server",
        "app-web"
    ],
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-router": "^1.170.41",
        "@tanstack/router-plugin": "^1.168.42",
        "@types/bun": "^1.4.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "es-toolkit": "^1.52.0",
        "kill-port-process": "^5.0.0",
        "lefthook": "^2.2.1",
        "lodash": "^4.18.1",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "zod": "^4.6.5"
    }
}