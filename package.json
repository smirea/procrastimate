{
	"name": "procrastimate",
	"private": true,
	"workspaces": [
		"server",
		"app-web"
	],
	"scripts": {
		"lint": "oxlint --fix && oxfmt",
		"test": "bun test",
		"generate": "bun scripts/generate/index.ts",
		"generate:watch": "bun --watch --no-clear-screen scripts/generate/index.ts",
		"db:generate": "drizzle-kit generate && bun run generate",
		"vectors": "VECTORS=record TZ=America/New_York bun test shared",
		"test:e2e": "bun run --cwd app-web test:e2e",
		"check": "bun run generate && bunx --bun tsc --noEmit && bun run --cwd app-web check",
		"start": "bun run generate && concurrently --raw -k -s first \"bun run start:server\" \"bun run start:client\" \"bun run generate:watch\"",
		"start:client": "bun run --cwd app-web start",
		"start:server": "bun run --cwd server start",
		"start:ios": "bun app-ios/scripts/run",
		"build": "bun run --cwd app-web build",
		"preview": "bun run build && bun server/scripts/secrets.ts dev-vars && bun scripts/wrangler-dev.ts",
		"dev": "bun run start",
		"client:dev": "bun run start:client",
		"server:dev": "bun run start:server",
		"env:generate": "env-manager gen --local",
		"env:pull": "env-manager down",
		"env:ios": "bun server/scripts/secrets.ts ios",
		"secrets:push": "bun server/scripts/secrets.ts push",
		"secrets:github": "bun server/scripts/secrets.ts github",
		"secrets:check": "bun server/scripts/secrets.ts check"
	},
	"dependencies": {
		"@orpc/client": "2.0.0-beta.43",
		"@orpc/contract": "2.0.0-beta.43",
		"@orpc/openapi": "2.0.0-beta.43",
		"@orpc/server": "2.0.0-beta.43",
		"@orpc/zod": "2.0.0-beta.43",
		"@sentry/bun": "11.8.0",
		"@sentry/cloudflare": "11.8.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"better-auth": "^1.7.7",
		"concurrently": "^10.0.6",
		"drizzle-orm": "0.45.4",
		"lefthook": "^2.2.1",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261010.1",
		"@electric-sql/pglite": "0.5.10",
		"@sentry/cli": "3.8.0",
		"drizzle-kit": "0.31.11",
		"postgres": "3.4.9",
		"wrangler": "^4.149.0"
	}
}
