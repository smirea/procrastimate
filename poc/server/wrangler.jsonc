{
	"name": "procrastimate-poc",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "00000000000000000000000000000000",
			"localConnectionString": "postgres://postgres:postgres@127.0.0.1:55432/app",
		},
	],
	"vars": { "POWERSYNC_URL": "http://127.0.0.1:58080", "BASE_URL": "http://127.0.0.1:58082" },
}
