{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": [
		"node_modules",
		".build",
		".swiftpm",
		"DerivedData",
		"dist",
		"build",
		"generated",
		"**/generated",
		"**/*.generated.ts",
		"**/*.gen.ts",
		".svelte-kit",
		"**/.svelte-kit",
		"test-results",
		"playwright-report",
		"shared/vectors/*.json",
		"app-web/env.ts",
		"server/src/env.ts",
		"scripts/env.ts"
	],
	"printWidth": 120,
	"useTabs": true,
	"semi": true,
	"singleQuote": true,
	"trailingComma": "all",
	"arrowParens": "avoid",
	"jsxSingleQuote": true
}
