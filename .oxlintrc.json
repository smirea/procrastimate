{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"no-unused-vars": "warn",
		"no-console": "off",
		"unicorn/no-null": "off",
		"unicorn/prefer-top-level-await": "off",
		"unicorn/filename-case": "off",
		"import/namespace": "off",
		"node/no-process-env": "error"
	},
	"overrides": [
		{
			"files": [
				"**/env.ts",
				"scripts/**",
				"server/scripts/**",
				"app-web/scripts/**",
				".claude/**",
				"**/playwright.config.ts",
				"**/*.test.ts",
				"app-web/e2e/**",
				"shared/vectors/record.ts"
			],
			"rules": {
				"node/no-process-env": "off"
			}
		},
		{
			"files": ["app-web/e2e/**/*.e2e.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "@playwright/test",
								"importNames": ["test"],
								"message": "Import `test` (or `quietTest`) from ./fixtures, whose auto fixture fails any test that reaches Sentry."
							}
						]
					}
				]
			}
		}
	],
	"ignorePatterns": [
		"node_modules",
		"dist",
		"build",
		"generated",
		"**/generated",
		"**/*.generated.ts",
		"**/*.gen.ts",
		".svelte-kit",
		"**/.svelte-kit",
		"test-results",
		"playwright-report"
	]
}
