{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "procrastimate",
	"main": "server/src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"routes": [{ "pattern": "procrastimate.stf.lol", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "app-web/build",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"],
	},
	"triggers": { "crons": ["0 9 * * *"] },
	"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "procrastimate-backups" }],
	"durable_objects": {
		"bindings": [{ "name": "ACCOUNT", "class_name": "Account" }],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["PushSchedule"] },
		{ "tag": "v2", "new_sqlite_classes": ["Account"] },
		{ "tag": "v3", "deleted_classes": ["PushSchedule"] },
	],
}
