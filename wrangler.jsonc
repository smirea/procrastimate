{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "procrastimate",
	"main": "server/src/api.ts",
	"compatibility_date": "2026-10-01",
	"routes": [{ "pattern": "procrastimate.stf.lol", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "app-web/build",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"],
	},
	"durable_objects": {
		"bindings": [
			{ "name": "PUSH", "class_name": "PushSchedule" },
			{ "name": "ACCOUNT", "class_name": "Account" },
		],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["PushSchedule"] },
		{ "tag": "v2", "new_sqlite_classes": ["Account"] },
	],
}
